# Agent Foreman Environment Configuration
# Copy this file to .env and adjust values as needed.

# --------------------------------------------------------------------------
# AI Agent Priority
# --------------------------------------------------------------------------
# Comma-separated list of agents in priority order (first = highest).
# Default: claude,codex,gemini
# Available agents: claude, codex, gemini, opencode
#
# Example: use OpenCode first, then Claude as fallback
# AGENT_FOREMAN_AGENTS=opencode,claude

# --------------------------------------------------------------------------
# Timeout Configuration (milliseconds)
# --------------------------------------------------------------------------
# Most AI operations have no timeout by default (wait until completion).
# Override here if you need hard limits.
#
# AGENT_FOREMAN_TIMEOUT_SCAN=900000        # AI project scan (default: ∞)
# AGENT_FOREMAN_TIMEOUT_VERIFY=600000      # AI verification (default: ∞)
# AGENT_FOREMAN_TIMEOUT_CAPABILITY=300000  # AI capability discovery (default: ∞)
# AGENT_FOREMAN_TIMEOUT_DEFAULT=300000     # Fallback timeout (default: ∞)

# --------------------------------------------------------------------------
# OpenCode-specific Options (optional, not yet implemented)
# --------------------------------------------------------------------------
# Set a specific model for OpenCode (provider/model format)
# AGENT_FOREMAN_OPENCODE_MODEL=anthropic/claude-3-5-sonnet
#
# Attach to a running opencode serve instance to avoid cold-boot latency
# AGENT_FOREMAN_OPENCODE_ATTACH=http://localhost:4096
